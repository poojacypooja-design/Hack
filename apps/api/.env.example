NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=solvex.sid
SESSION_TTL_HOURS=12
# Local PostgreSQL role/database are both named solvex; replace this placeholder password.
DATABASE_URL=postgresql://solvex:replace-me@localhost:5432/solvex?schema=public
UPLOAD_DIR=./storage/uploads
NO_SILENCE_DEFAULT_HOURS=4

# Optional: set all three to create a local administrator during seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
