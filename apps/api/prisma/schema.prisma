generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
}

enum DomainMode {
  HEALTH
  LOGISTICS
  SMART_OPERATIONS
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_REASSIGNED
  NEW_MESSAGE
  STATUS_CHANGED
  SLA_WARNING
  ESCALATION
  RESOLUTION
  NO_SILENCE
  CUSTOMER_FEEDBACK
  ASSIGNMENT_FAILED
}

enum TicketHistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  REASSIGNED
  ESCALATED
  PUBLIC_MESSAGE
  INTERNAL_NOTE
  RESOLUTION_SAVED
  INCIDENT_LINKED
}

enum IncidentStatus {
  POTENTIAL
  CONFIRMED
  RESOLVED
}

enum TicketComplexity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketAnalysisMethod {
  RULE_BASED
  AI_PROVIDER
}

enum AssignmentSource {
  AUTOMATIC
  MANUAL
  CLAIM
}

enum AssignmentStatus {
  PENDING
  ASSIGNED
  WAITING
  DISABLED
  FAILED
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  email                 String               @unique @db.VarChar(320)
  passwordHash          String               @db.VarChar(255)
  fullName              String               @db.VarChar(120)
  role                  UserRole
  phone                 String?              @db.VarChar(32)
  company               String?              @db.VarChar(160)
  preferredDomain       DomainMode?
  isActive              Boolean              @default(true)
  isAvailable           Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  sessions              Session[]
  customerTickets       Ticket[]             @relation("CustomerTickets")
  assignedTickets       Ticket[]             @relation("AssignedTickets")
  publicMessages        TicketMessage[]      @relation("MessageAuthor")
  internalNotes         InternalNote[]       @relation("InternalNoteAuthor")
  attachmentsUploaded   TicketAttachment[]
  assignmentsCreated    TicketAssignment[]   @relation("AssignmentActor")
  assignmentsReceived   TicketAssignment[]   @relation("AssignedAgent")
  assignmentsFrom       TicketAssignment[]   @relation("PreviousAgent")
  historyEntries        TicketHistory[]      @relation("HistoryActor")
  notifications         Notification[]
  feedback              TicketFeedback[]
  receivedFeedback      TicketFeedback[]      @relation("FeedbackAgent")
  skills                AgentSkill[]
  incidentsCreated      TicketIncidentGroup[] @relation("IncidentCreator")
  knowledgeAuthored     ResolutionKnowledge[] @relation("KnowledgeAuthor")

  @@index([role, isActive])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Ticket {
  id                String                 @id @default(uuid()) @db.Uuid
  ticketCode        String                 @unique @db.VarChar(40)
  subject           String                 @db.VarChar(180)
  description       String                 @db.Text
  category          String                 @db.VarChar(100)
  domain            DomainMode
  priority          TicketPriority         @default(MEDIUM)
  status            TicketStatus           @default(OPEN)
  escalationLevel   Int                    @default(0)
  customerId        String                 @db.Uuid
  assignedAgentId   String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  resolvedAt        DateTime?
  customer          User                   @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Restrict)
  assignedAgent     User?                  @relation("AssignedTickets", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages          TicketMessage[]
  internalNotes     InternalNote[]
  attachments       TicketAttachment[]
  assignments       TicketAssignment[]
  slaRecord         SLARecord?
  feedback          TicketFeedback?
  analysis          TicketAnalysis?
  history           TicketHistory[]
  notifications     Notification[]
  incidentLinks     TicketIncidentLink[]
  resolution        ResolutionKnowledge?

  @@index([customerId, createdAt])
  @@index([assignedAgentId, status, priority])
  @@index([status, priority, createdAt])
  @@index([domain, category])
  @@index([updatedAt, status])
}

model TicketMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User     @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model InternalNote {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User     @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model TicketAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  uploadedById String   @db.Uuid
  originalName String   @db.VarChar(255)
  storageKey   String   @unique @db.VarChar(80)
  mimeType     String   @db.VarChar(100)
  sizeBytes    Int
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model TicketAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  ticketId       String   @db.Uuid
  assignedToId   String   @db.Uuid
  assignedById   String?  @db.Uuid
  previousAgentId String? @db.Uuid
  note           String?  @db.VarChar(500)
  score          Float?
  reason         String?  @db.VarChar(1000)
  source         AssignmentSource @default(MANUAL)
  createdAt      DateTime @default(now())
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedTo     User     @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy     User?    @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)
  previousAgent  User?    @relation("PreviousAgent", fields: [previousAgentId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([assignedToId, createdAt])
}

model SLAPolicy {
  id                       String       @id @default(uuid()) @db.Uuid
  domain                   DomainMode
  priority                 TicketPriority
  firstResponseMinutes     Int
  resolutionMinutes        Int
  updateIntervalHours      Int          @default(4)
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  records                  SLARecord[]

  @@unique([domain, priority])
  @@index([isActive, domain])
}

model SLARecord {
  id                     String    @id @default(uuid()) @db.Uuid
  ticketId               String    @unique @db.Uuid
  policyId               String?   @db.Uuid
  firstResponseDueAt     DateTime
  resolutionDueAt        DateTime
  firstResponseAt        DateTime?
  resolvedAt             DateTime?
  firstResponseBreached  Boolean   @default(false)
  resolutionBreached     Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  ticket                 Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policy                 SLAPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([firstResponseDueAt, firstResponseBreached])
  @@index([resolutionDueAt, resolutionBreached])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  ticketId    String?          @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(160)
  body        String           @db.VarChar(500)
  dedupeKey   String?          @unique @db.VarChar(200)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket      Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([ticketId, createdAt])
}

model TicketFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @unique @db.Uuid
  customerId  String   @db.Uuid
  agentId     String?  @db.Uuid
  rating      Int
  agentRating Int?
  communicationRating Int?
  resolutionRating Int?
  comment     String?  @db.VarChar(2000)
  suggestions String?  @db.VarChar(2000)
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent       User?    @relation("FeedbackAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([rating, createdAt])
  @@index([agentId, createdAt])
}

model TicketHistory {
  id         String              @id @default(uuid()) @db.Uuid
  ticketId   String              @db.Uuid
  actorId    String?             @db.Uuid
  action     TicketHistoryAction
  metadata   Json?
  createdAt  DateTime            @default(now())
  ticket     Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User?               @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actorId, createdAt])
}

model AgentSkill {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  domain     DomainMode
  category   String     @db.VarChar(100)
  skillLevel Int        @default(1)
  skillTags  String[]   @default([])
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain, category])
  @@index([domain, category, skillLevel])
}

model TicketAnalysis {
  id                 String               @id @default(uuid()) @db.Uuid
  ticketId           String               @unique @db.Uuid
  problemCategory    String               @db.VarChar(100)
  subcategory        String?              @db.VarChar(100)
  reportedProblem    String               @db.Text
  keywords           String[]             @default([])
  requiredSkills     String[]             @default([])
  complexity         TicketComplexity
  recommendedPriority TicketPriority
  suggestedTeam      String?              @db.VarChar(120)
  resolutionApproach String?              @db.Text
  potentialSlaRisk   String?              @db.VarChar(20)
  analysisMethod     TicketAnalysisMethod @default(RULE_BASED)
  similarTicketIds   String[]             @default([])
  assignmentStatus   AssignmentStatus     @default(PENDING)
  assignmentReason   String?              @db.VarChar(1000)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ticket             Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([assignmentStatus, createdAt])
  @@index([problemCategory, complexity])
}

model AssignmentSettings {
  id                    String   @id @default("global") @db.VarChar(20)
  automaticEnabled      Boolean  @default(true)
  skillWeight           Int      @default(35)
  workloadWeight        Int      @default(25)
  similarIssueWeight    Int      @default(15)
  availabilityWeight    Int      @default(15)
  slaPerformanceWeight  Int      @default(10)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model TicketIncidentGroup {
  id           String                @id @default(uuid()) @db.Uuid
  title        String                @db.VarChar(180)
  summary      String                @db.VarChar(1000)
  status       IncidentStatus        @default(POTENTIAL)
  createdById  String                @db.Uuid
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdBy    User                  @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tickets      TicketIncidentLink[]

  @@index([status, createdAt])
}

model TicketIncidentLink {
  ticketId    String              @db.Uuid
  groupId     String              @db.Uuid
  similarity  Float
  createdAt   DateTime            @default(now())
  ticket      Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  group       TicketIncidentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([ticketId, groupId])
  @@index([groupId, similarity])
}

model ResolutionKnowledge {
  id             String     @id @default(uuid()) @db.Uuid
  ticketId       String     @unique @db.Uuid
  authorId       String     @db.Uuid
  title          String     @db.VarChar(180)
  issueSummary   String     @db.VarChar(2000)
  solution       String     @db.Text
  domain         DomainMode
  category       String     @db.VarChar(100)
  tags           String[]   @default([])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  ticket         Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author         User       @relation("KnowledgeAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([domain, category, createdAt])
}
