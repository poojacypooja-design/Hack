# Frontend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Express API
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=solvex.sid
SESSION_TTL_HOURS=12
# Local PostgreSQL role/database are both named solvex; replace this placeholder password.
DATABASE_URL=postgresql://solvex:replace-me@localhost:5432/solvex?schema=public
POSTGRES_PASSWORD=replace-me
UPLOAD_DIR=./storage/uploads
NO_SILENCE_DEFAULT_HOURS=4

# Optional initial administrator for the development seed only.
# No admin or agent registration endpoint is exposed publicly.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
